# Copy to .env.cloud for laptop or Oracle engine against shared cloud services.
ACIS_DEPLOY_MODE=local
ACIS_ENV=production
ACIS_LOG_LEVEL=INFO
ACIS_LOG_PATH=/data/acis.log
ACIS_OFFSET_RESET=latest
ACIS_API_KEY=replace_with_32_plus_char_secret________________

# Confluent Cloud
ACIS_KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.aws.confluent.cloud:9092
ACIS_KAFKA_BACKEND=confluent
ACIS_KAFKA_SECURITY_PROTOCOL=SASL_SSL
ACIS_KAFKA_SASL_MECHANISM=PLAIN
ACIS_KAFKA_SASL_USERNAME=
ACIS_KAFKA_SASL_PASSWORD=

# Supabase (same URL for laptop engine, Oracle engine, Render BFF)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
ACIS_DATABASE_URL=${DATABASE_URL}

GROQ_API_KEY=
