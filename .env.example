# =============================================================================
# ACIS-X environment template
# Copy to .env (local/offline) or .env.cloud (Confluent + Supabase + dual engine)
# =============================================================================

# --- Mode ---
ACIS_DEPLOY_MODE=local
# local | oracle | cloud

ACIS_ENV=development
ACIS_LOG_LEVEL=INFO
ACIS_LOG_PATH=acis.log
ACIS_OFFSET_RESET=latest
ACIS_REGISTRY_PORT=5000
ACIS_API_KEY=change_me

# --- Kafka ---
# Offline Docker Kafka:
ACIS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ACIS_KAFKA_BACKEND=confluent
ACIS_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# ACIS_KAFKA_SASL_MECHANISM=
# ACIS_KAFKA_SASL_USERNAME=
# ACIS_KAFKA_SASL_PASSWORD=

# Confluent Cloud (uncomment + fill for laptop/Oracle against shared Kafka):
# ACIS_KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.aws.confluent.cloud:9092
# ACIS_KAFKA_BACKEND=confluent
# ACIS_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# ACIS_KAFKA_SASL_MECHANISM=PLAIN
# ACIS_KAFKA_SASL_USERNAME=<API_KEY>
# ACIS_KAFKA_SASL_PASSWORD=<API_SECRET>

# --- Database ---
# Offline SQLite (unit tests / no network):
ACIS_DB_PATH=acis.db

# Standard hosted DB — same Supabase URL for laptop engine, Oracle engine, and Render BFF:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# ACIS_DATABASE_URL=${DATABASE_URL}

# --- LLM ---
GROQ_API_KEY=

# --- BFF / Frontend (when running locally) ---
ACIS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_KEY=change_me
